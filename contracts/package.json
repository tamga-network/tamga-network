{
  "name": "tamga-network-contracts",
  "private": true,
  "version": "1.0.0",
  "description": "Tamga Network güven katmanı kontratları (SPEC-BC-0001) — Hardhat derleme, test ve yerel geliştirme zinciri. Üretim zinciri yok (ADR-0009 K4).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:dev": "hardhat run scripts/deploy-dev.ts --network localhost",
    "deploy:besu": "hardhat run scripts/deploy-dev.ts --network besuDev",
    "deploy:network": "hardhat run scripts/deploy-network.ts --network besuStaging",
    "deploy:inmemory": "hardhat run scripts/deploy-dev.ts",
    "abi:export": "node scripts/export-abi.mjs",
    "check:uups": "node scripts/check-upgrade-safety.mjs",
    "check:storage": "node scripts/check-storage-layout.mjs",
    "check:size": "node scripts/check-code-size.mjs",
    "storage:update": "node scripts/check-storage-layout.mjs --update",
    "slither": "node scripts/slither.mjs",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.0",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.20.0",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}
