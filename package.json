{
  "name": "tamga-network",
  "private": true,
  "version": "1.0.0",
  "description": "Tamga Network — eIDAS 2.0 / ETSI / EUDI uyumlu dijital güven altyapısı (public monorepo). Faz B: imzalı güven listeleri; Faz 0: Besu.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pki": "tsx ops/gen-pki.ts",
    "schemas:build": "tsx packages/schemas/src/build.ts",
    "trust:build": "tsx apps/trust-publisher/src/cli.ts build",
    "trust:anchor": "tsx apps/trust-publisher/src/cli.ts anchor",
    "trust:heartbeat": "tsx apps/trust-publisher/src/cli.ts heartbeat",
    "trust:verify": "tsx apps/trust-publisher/src/cli.ts verify",
    "trust:archive": "tsx apps/trust-publisher/src/cli.ts archive",
    "trust:test-fixtures": "node scripts/trust-test-fixtures.mjs",
    "pki:sandbox": "tsx ops/gen-pki.ts --profile=sandbox",
    "trust:build:sandbox": "node scripts/trust-test-fixtures.mjs --sandbox",
    "conformance:gen": "tsx conformance/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "npm run pki && npm run schemas:build && npm run trust:build && npm run trust:build && npm run trust:heartbeat && npm run trust:verify && npm run trust:test-fixtures && npm run pki:sandbox && npm run trust:build:sandbox",
    "check": "npm test && npm run typecheck",
    "conformance": "npm run conformance:gen && npm test",
    "docs:sync": "node scripts/docs-sync-root.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && node scripts/public-text-check.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/public-text-check.mjs && node scripts/docs-i18n-check.mjs",
    "docs:index": "node scripts/master-index.mjs",
    "arf:sync": "node scripts/arf-sync.mjs",
    "arf:check": "node scripts/arf-sync.mjs --check",
    "arf:snapshot": "node scripts/arf-sync.mjs --snapshot",
    "arf:dev": "npm run arf:sync && vitepress dev arf",
    "arf:build": "npm run arf:sync && vitepress build arf",
    "arf:preview": "vitepress preview arf",
    "verify": "tsx apps/verify/src/server.ts",
    "trust:status": "tsx apps/trust-publisher/src/cli.ts status",
    "trust:register": "tsx apps/trust-publisher/src/cli.ts register",
    "trust:scope": "tsx apps/trust-publisher/src/cli.ts scope",
    "trust:authorize": "tsx apps/trust-publisher/src/cli.ts authorize",
    "trust:list": "tsx apps/trust-publisher/src/cli.ts list",
    "pki:issue": "tsx ops/pki-issue.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\" \"conformance/**/*.ts\" \"scripts/**/*.mjs\" \"ops/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"conformance/**/*.ts\" \"scripts/**/*.mjs\" \"ops/**/*.ts\"",
    "build:packages": "tsc -b tsconfig.build.json",
    "pack:packages": "node scripts/pack-packages.mjs",
    "smoke:packages": "node scripts/smoke-packages.mjs",
    "release:check": "npm run -s pack:packages && npm run -s smoke:packages",
    "trust:external": "tsx apps/trust-publisher/src/cli.ts external-fetch",
    "release:version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.0",
    "@peculiar/x509": "^1.12.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
