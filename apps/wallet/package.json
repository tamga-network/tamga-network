{
  "name": "@tamga-network/wallet-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tamga Wallet — Expo + expo-router (iOS önce, Expo Go). D3+D4+D5+ADR-0011 akışları; UI: .claude/skills/wallet-ux.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "export:check": "expo export --platform ios --output-dir .expo-export-check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "npm run -s format:check && npm run -s lint && npm run -s typecheck",
    "pin:trust": "node scripts/pin-trust.mjs",
    "build:dev": "npx eas-cli@latest build --profile development --platform all",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:store": "npx eas-cli@latest build --profile production --platform all",
    "submit:store": "npx eas-cli@latest submit --profile production --platform all",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tamga-network/wallet-core": "*",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
