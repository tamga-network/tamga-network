{
  "expo": {
    "name": "Tamga Wallet",
    "slug": "tamga-wallet",
    "version": "0.1.0",
    "scheme": [
      "tamga-wallet",
      "openid4vp",
      "openid-credential-offer"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "network.tamga.wallet",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan credential invitations and verification requests (QR codes).",
        "NSFaceIDUsageDescription": "Face ID is used to open your credentials and to approve each sharing.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth connects to a reader nearby when you show a credential in person.",
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "network.tamga.wallet",
      "adaptiveIcon": {
        "backgroundColor": "#17110F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan credential invitations and verification requests (QR codes)."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID is used to open your credentials and to approve each sharing."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F4EDE2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#17110F"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-router",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    }
  }
}
