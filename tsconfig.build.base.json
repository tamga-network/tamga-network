{
  "//": "npm yayını için paket derleme tabanı (scripts/build-packages.mjs). Geliştirme kök tsconfig.json ile kaynaktan çalışır; bu dosya yalnızca lib/ üretir.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noEmitOnError": true
  }
}
